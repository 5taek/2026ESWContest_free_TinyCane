  { if (!((u) & ~((1ULL << (16)) - 1ULL))) return BIT_WIDTH_16; };
  { if (!((u) & ~((1ULL << (32)) - 1ULL))) return BIT_WIDTH_32; };

  return BIT_WIDTH_64;
}

inline BitWidth WidthI(int64_t i) {
  auto u = static_cast<uint64_t>(i) << 1;
  return WidthU(i >= 0 ? u : ~u);
}

inline BitWidth WidthF(double f) {
